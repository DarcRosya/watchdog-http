# ===================================
# POSTGRES (TEST DATABASE)
# ===================================
# IMPORTANT: Use a separate database for testing!
# Tests will clear data after each run.
DB__USER=your_db_user
DB__PASS=your_db_password
DB__HOST=localhost
DB__PORT=5433
DB__NAME=watchdog_test

# ===================================
# REDIS (TEST INSTANCE)
# ===================================
# It is recommended to use a separate Redis or another database (e.g. DB=1)
REDIS__HOST=localhost
REDIS__PORT=6380

# ===================================
# TELEGRAM (OPTIONAL FOR TESTS)
# ===================================
# Can be left blank - tests will use mocks
TELEGRAM__BOT_TOKEN=your_test_bot_token_here

# ===================================
# OTHER SETTINGS
# ===================================
DEBUG_MODE=true
ENABLE_FILE_LOGGING=false


# ===================================
# SETUP INSTRUCTIONS
# ===================================
# 1. Copy this file:
#    cp .env.test.example .env.test
#
# 2. Configure the variables above for your setup
#
# 3. Start test containers:
#    make test-infra-up
#
# 4. Run the tests:
#    make test
#
# 5. With coverage:
#    make test-cov
#
# 6. Stop containers:
#    make test-infra-down
