# ===================================
# POSTGRES (ТЕСТОВАЯ БД)
# ===================================
# ВАЖНО: Используйте отдельную БД для тестов!
# Тесты будут очищать данные после каждого запуска
DB__USER=your_db_user
DB__PASS=your_db_password
DB__HOST=localhost
DB__PORT=5432
DB__NAME=watchdog_test

# ===================================
# REDIS (ТЕСТОВЫЙ ИНСТАНС)
# ===================================
# Рекомендуется использовать отдельный Redis или другую БД (например DB=1)
REDIS__HOST=localhost
REDIS__PORT=6379

# ===================================
# TELEGRAM (ОПЦИОНАЛЬНО ДЛЯ ТЕСТОВ)
# ===================================
# Можно оставить пустым - тесты будут использовать моки
TELEGRAM_BOT_TOKEN=your_test_bot_token_here
TELEGRAM_CHAT_ID=your_test_chat_id_here

# ===================================
# ДРУГИЕ НАСТРОЙКИ
# ===================================
DEBUG_MODE=true
ENABLE_FILE_LOGGING=false

# ===================================
# ИНСТРУКЦИЯ ПО НАСТРОЙКЕ
# ===================================
# 1. Создайте тестовую БД:
#    docker exec -it watchdog_db psql -U your_db_user -c "CREATE DATABASE watchdog_test;"
#    или используйте: make test-setup
#
# 2. Скопируйте этот файл:
#    cp .env.test.example .env.test
#
# 3. Настройте переменные выше под вашу конфигурацию
#
# 4. Запустите тесты:
#    make test
#
# 5. С coverage:
#    make test-cov
