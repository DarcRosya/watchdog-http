# ===================================
# POSTGRES (TEST DATABASE)
# ===================================
# IMPORTANT: Use a separate database for testing!
# Tests will clear data after each run.
DB__USER=your_db_user
DB__PASS=your_db_password
DB__HOST=localhost
DB__PORT=5432
DB__NAME=watchdog_test

# ===================================
# REDIS (TEST INSTANCE)
# ===================================
# It is recommended to use a separate Redis or another database (e.g. DB=1)
REDIS__HOST=localhost
REDIS__PORT=6379

# ===================================
# TELEGRAM (OPTIONAL FOR TESTS)
# ===================================
# Can be left blank - tests will use mocks
TELEGRAM_BOT_TOKEN=your_test_bot_token_here
TELEGRAM_CHAT_ID=your_test_chat_id_here

# ===================================
# OTHER SETTINGS
# ===================================
DEBUG_MODE=true
ENABLE_FILE_LOGGING=false


# ===================================
# SETUP INSTRUCTIONS
# ===================================
# 1. Create a test database:
#    docker exec -it watchdog_db psql -U your_db_user -c “CREATE DATABASE watchdog_test;”
#    or use: make test-setup
#
# 2. Copy this file:
#    cp .env.test.example .env.test
#
# 3. Configure the variables above for your setup
#
# 4. Run the tests:
#    make test
#
# 5. With coverage:
#    make test-cov
